# Copy to a local `.env` (gitignored) and load it in your shell without pasting
# secrets into chat or shell history, e.g.:
#   set -a && source .env && set +a
#
# Never put API keys in oren.json.

# --- Model (pick one provider) ---
# OREN_MODEL_PROVIDER=deepseek
# OREN_MODEL_ID=deepseek-v4-pro
# DEEPSEEK_API_KEY=

# OREN_MODEL_PROVIDER=anthropic
# OREN_MODEL_ID=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# Or rely on oren.json for provider/id and only set the matching API key here.
