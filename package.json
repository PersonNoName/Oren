{
  "name": "oren",
  "version": "0.2.0",
  "private": true,
  "description": "Continuous-presence agent with its own inner life",
  "type": "module",
  "bin": {
    "oren": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "npm run build",
    "oren": "node --import tsx src/cli.ts",
    "demo": "npm run build && node dist/cli.js demo",
    "start": "npm run build && node dist/cli.js serve",
    "demo:dev": "node --import tsx src/cli.ts demo"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.6"
  }
}
