{
  "name": "oren",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "extensions/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npx tsc --noEmit",
    "build": "npx tsc -p tsconfig.json && node scripts/prepare-dist.mjs",
    "start": "npm run build && node --enable-source-maps dist/packages/app/src/serve.js",
    "smoke": "npm run build && node --enable-source-maps dist/packages/app/src/smoke.js",
    "eval": "npm run build && node --enable-source-maps dist/packages/evals/src/eval.js",
    "sim": "npm run build && node --enable-source-maps dist/packages/sim/src/sim.js",
    "panel-ui": "npm run dev -w @oren/panel-ui"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
