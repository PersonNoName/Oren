<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to ~/Library/LaunchAgents/com.oren.tick.plist and edit PATHS.
  launchctl load ~/Library/LaunchAgents/com.oren.tick.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.oren.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/robot/Documents/Projects/Oren &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a &amp;&amp; export OREN_HOME=/Users/robot/Documents/Projects/Oren/.oren-life &amp;&amp; /usr/local/bin/node --import tsx src/cli.ts tick</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/oren-tick.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/oren-tick.err.log</string>
</dict>
</plist>
